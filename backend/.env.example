APP_ENV=development
ALLOW_ORIGINS=http://localhost:8003,http://localhost:5173

REDIRECT_DOMAIN=example.com

POSTGRES_ADDR=localhost
POSTGRES_PORT=5432
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydb
POSTGRES_TEST_DB=mytestdb

# Database connection pool sizing. Keep MAX below Postgres' max_connections (~100).
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=5

# Redirect-path cache: max cached links and how long an entry may be stale.
# Set REDIRECT_CACHE_SIZE=0 (or TTL=0) to disable the cache.
REDIRECT_CACHE_SIZE=100000
REDIRECT_CACHE_TTL=60s

# Optional: enable Go pprof on a separate debug port (dev only, leave empty to disable).
# e.g. PPROF_ADDR=localhost:6060 -> http://localhost:6060/debug/pprof/
PPROF_ADDR=
