# Cloudflare R2 configuration for the PostgreSQL backup/restore tooling
# (ops/backup/). Copy this file to backend/.env.backup and fill in real
# values. backend/.env.backup must never be committed to Git.
#
# The R2 API token used here should be scoped to Object Read & Write on the
# single bucket named below -- never a Global API Key or an
# account-administration token. See ops/backup/README.md for how to create
# the bucket, the scoped token, the Lifecycle rule and the Bucket Lock.

R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=linkhub-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Prefix under which backups are stored in the bucket:
#   <BACKUP_PREFIX>/<YYYY>/<MM>/<YYYY-MM-DDTHHMMSSZ>/
BACKUP_PREFIX=postgres

# Informational only in this version -- actual retention is enforced by an
# R2 Lifecycle rule on the bucket, not by backup.sh. Keep this in sync with
# the Lifecycle rule you configure in the Cloudflare dashboard.
BACKUP_RETENTION_DAYS=30
